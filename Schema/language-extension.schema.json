{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nodal-ide/CodeEditLang/master/Schema/language-extension.schema.json",
  "title": "CodeEdit Language Extension",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schemaVersion": {
      "type": "integer",
      "enum": [1, 2],
      "description": "Manifest schema version. Manifests that omit it are treated as v1."
    },
    "id": { "type": "string", "minLength": 1, "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$", "description": "Reverse-DNS identifier, e.g. com.example.pack." },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["languagePack", "languageProvider", "nativeSyntaxPack", "settings", "sidebar", "theme", "action"]
    },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "url": { "type": "string", "format": "uri" },
    "icon": { "type": "string", "description": "Path to an image, relative to the pack root." },
    "languages": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Document languages this pack targets for provider/symbol contributions."
    },
    "framework": { "type": "string", "description": "Framework this pack targets, e.g. laravel/framework." },
    "engines": {
      "type": "object",
      "description": "Host version requirements. `codeedit` accepts a semver range such as `>=0.18.0` or `^0.18.0`.",
      "properties": { "codeedit": { "type": "string" } },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "array",
      "description": "Capabilities the pack needs. `nativeGrammars` requires explicit user consent.",
      "items": { "type": "string" }
    },
    "activation": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Literal workspace-relative marker paths. Wildcards are ignored."
        },
        "framework": {
          "type": "object",
          "properties": {
            "file": { "type": "string", "default": "composer.json" },
            "requires": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        }
      }
    },
    "contributes": {
      "type": "object",
      "properties": {
        "syntax": {
          "type": "array",
          "description": "Declarative syntax contributions. A contribution reuses a built-in grammar (query-only pack) or names a native grammar dylib shipped in the pack.",
          "items": {
            "type": "object",
            "required": ["id", "grammar", "queries"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "description": "Document language identifier." },
              "displayName": { "type": "string" },
              "extensions": { "type": "array", "items": { "type": "string" } },
              "filenames": { "type": "array", "items": { "type": "string" } },
              "shebangs": { "type": "array", "items": { "type": "string" } },
              "firstLinePatterns": { "type": "array", "items": { "type": "string" } },
              "aliases": { "type": "array", "items": { "type": "string" } },
              "comments": {
                "type": "object",
                "description": "Comment tokens used by toggle-comment. Native packs should declare these; query-only packs inherit the built-in grammar's tokens unless overridden.",
                "properties": {
                  "line": { "type": "string" },
                  "block": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": { "type": "string" },
                    "description": "Start and end tokens of a block comment, e.g. [\"<!--\", \"-->\"]."
                  }
                }
              },
              "grammar": {
                "type": "object",
                "required": ["kind"],
                "properties": {
                  "kind": { "type": "string", "enum": ["builtin", "native"] },
                  "name": { "type": "string", "description": "Built-in grammar name, e.g. `html`. Required when kind is `builtin`." },
                  "path": { "type": "string", "description": "Native grammar path relative to the pack root, ending in `.dylib`. Required when kind is `native`." },
                  "symbol": { "type": "string", "pattern": "^tree_sitter_[A-Za-z0-9_]+$", "description": "Exported tree-sitter symbol, e.g. tree_sitter_svelte. Required when kind is `native`." },
                  "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Expected SHA-256 of the native grammar binary. Optional; when present it is verified before loading." }
                }
              },
              "queries": {
                "type": "object",
                "required": ["highlights"],
                "description": "Query file paths relative to the pack root.",
                "properties": {
                  "highlights": { "type": "string" },
                  "injections": { "type": "string" },
                  "folds": { "type": "string" },
                  "indents": { "type": "string" },
                  "locals": { "type": "string" },
                  "tags": { "type": "string" },
                  "parent": { "type": "string" }
                }
              }
            },
            "additionalProperties": true
          }
        },
        "themes": {
          "type": "array",
          "description": "Theme documents (cetheme files) contributed to the app's theme list.",
          "items": {
            "type": "object",
            "required": ["id", "path"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "description": "Stable theme id, unique inside the pack." },
              "path": { "type": "string", "description": "Theme file path relative to the pack root." }
            }
          }
        },
        "symbols": { "type": "array", "items": { "type": "string" } },
        "snippets": { "type": "array", "items": { "type": "string" } },
        "stubRoots": { "type": "array", "items": { "type": "string" } },
        "knowledge": {
          "type": "array",
          "description": "Offline documentation sets (Markdown/HTML pages + index.json).",
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "root": { "type": "string", "description": "Folder inside the pack. Defaults to the pack root." },
              "index": { "type": "string", "description": "Index file relative to root. Defaults to index.json." }
            }
          }
        },
        "provider": {
          "type": "object",
          "description": "An out-of-process language provider spoken to over JSON-RPC on stdio.",
          "required": ["command"],
          "properties": {
            "command": { "type": "string", "description": "Executable (path resolved relative to the pack root, or a PATH name)." },
            "args": { "type": "array", "items": { "type": "string" } },
            "languages": { "type": "array", "items": { "type": "string" } },
            "env": { "type": "object", "additionalProperties": { "type": "string" } },
            "completionTriggers": {
              "type": "array",
              "description": "Single-character triggers that open the completion window, e.g. [\".\", \":\"].",
              "items": { "type": "string", "minLength": 1, "maxLength": 1 },
              "maxItems": 16
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
